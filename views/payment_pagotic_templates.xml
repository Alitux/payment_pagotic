<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="redirect_form">
        <form t-att-action="form_action" method="get">
            <t t-foreach="form_params" t-as="param">
                <input type="hidden" t-att-name="param['name']" t-att-value="param['value']"/>
            </t>
        </form>
    </template>

</odoo>
