<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">PagoTIC Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group name="pagotic_credentials" string="PagoTIC" invisible="code != 'pagotic'">
                    <field name="pagotic_username"/>
                    <field name="pagotic_password" password="True"/>
                    <field name="pagotic_client_id"/>
                    <field name="pagotic_client_secret" password="True"/>
                    <field name="pagotic_auth_url"/>
                    <field name="pagotic_api_url"/>
                    <field name="pagotic_realm"/>
                </group>
                <group name="pagotic_configuration" string="PagoTIC Checkout" invisible="code != 'pagotic'">
                    <field name="pagotic_concept_id"/>
                    <field name="pagotic_concept_description"/>
                    <field name="pagotic_media_payment_ids"/>
                    <field name="pagotic_collector_id"/>
                    <button name="action_pagotic_fetch_collector_id"
                            type="object"
                            string="Fetch Collector ID"
                            class="btn-link"
                            icon="fa-refresh"
                            colspan="2"/>
                    <div colspan="2" class="text-muted">
                        The webhook URL is <code>/payment/pagotic/webhook</code>.
                        It must be reachable from the Internet. The collector ID can be
                        left empty: it is fetched automatically on the first payment.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
